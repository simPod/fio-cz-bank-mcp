{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>simPod/renovatebot-presets:base",
    "github>simPod/renovatebot-presets:js-base"
  ],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25",
      "patch": {
        "enabled": true
      }
    },
    {
      "matchPackageNames": [
        "@modelcontextprotocol/server",
        "@modelcontextprotocol/client"
      ],
      "groupName": "MCP SDK"
    }
  ]
}
